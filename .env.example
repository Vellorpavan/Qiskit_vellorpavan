# ShiftProof — Environment Configuration Template
# Copy this file to .env and insert your real credentials.
# NEVER commit your actual .env file or API tokens to git.

# IBM Quantum Platform API Token (from https://quantum.ibm.com/)
IBM_QUANTUM_TOKEN=

# Optional: IBM Quantum Instance / Cloud Resource Name (CRN)
# Required only if using IBM Cloud quantum channel:
# crn:v1:bluemix:public:quantum-computing:...
IBM_QUANTUM_INSTANCE=

# IBM Quantum Channel: 'ibm_quantum' (default) or 'ibm_cloud'
IBM_QUANTUM_CHANNEL=ibm_quantum
